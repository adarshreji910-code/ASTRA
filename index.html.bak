<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ASTRA — Explore The Universe</title>
  <meta name="description" content="ASTRA is an immersive space-exploration dashboard. Explore planets, galaxies, cosmic events and the mysteries beyond Earth.">
  
  <!-- Modern Clean Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700;800&display=swap" rel="stylesheet">

  <!-- Three.js Stable Engine CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

  <!-- ASTRA Asteroid Collision Stylesheet -->
  <link rel="stylesheet" href="css/asteroid-collision.css">

  <style>
    /* ==========================================================================
       CSS VARIABLES & CINEMATIC PALETTE (MATCHING MASTER REFERENCE)
       ========================================================================== */
    :root {
      --bg-color: #020409;
      --panel-bg: rgba(9, 15, 25, 0.44);
      --panel-border: rgba(255, 255, 255, 0.08);
      --panel-border-hover: rgba(100, 210, 255, 0.28);
      --card-bg: rgba(12, 19, 30, 0.52);
      --card-border: rgba(255, 255, 255, 0.065);
      --card-border-hover: rgba(100, 210, 255, 0.38);
      --text-main: #ffffff;
      --text-muted: #8ca2b9;
      --text-dim: #516277;
      --accent-cyan: #64d2ff;
      --accent-cyan-glow: rgba(100, 210, 255, 0.4);
      --accent-green: #00e699;
      --accent-amber: #ffaa33;
      
      --font-display: 'Space Grotesk', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      
      --glass-blur: blur(28px);
      --panel-radius: 14px;
      --card-radius: 10px;
      --transition-smooth: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: var(--bg-color);
      color: var(--text-main);
      font-family: var(--font-body);
      user-select: none;
    }

    /* ==========================================================================
       THREE.JS WEBGL CANVAS (EARTH & SPACE)
       ========================================================================== */
    #webgl-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: 1;
      pointer-events: none;
    }

    /* Ambient Space Dust & Soft Nebula Haze in Space */
    .space-backdrop {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      background:
        radial-gradient(circle at 45% 18%, rgba(20, 48, 85, 0.28) 0%, transparent 55%),
        radial-gradient(circle at 82% 12%, rgba(12, 30, 56, 0.35) 0%, transparent 45%),
        radial-gradient(circle at 20% 40%, rgba(15, 35, 65, 0.2) 0%, transparent 50%),
        #020409;
      pointer-events: none;
    }

    /* ==========================================================================
       PAGE CONTAINER & UI OVERLAY
       ========================================================================== */
    .app-viewport {
      position: relative;
      width: 100vw;
      height: 100vh;
      z-index: 10;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 32px 52px 36px 52px;
      overflow: hidden;
      pointer-events: none;
    }

    .interactive-element {
      pointer-events: auto;
    }

    /* ==========================================================================
       HEADER & NAVIGATION (EXACT MASTER MATCH)
       ========================================================================== */
    .site-header {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      z-index: 20;
    }

    .brand-group {
      display: flex;
      flex-direction: column;
      cursor: pointer;
      text-decoration: none;
    }

    .brand-logo {
      font-family: var(--font-display);
      font-size: 26px;
      font-weight: 700;
      letter-spacing: 0.22em;
      color: var(--text-main);
      text-transform: uppercase;
      line-height: 1;
      text-shadow: 0 0 20px rgba(255, 255, 255, 0.25);
    }

    .brand-tagline {
      font-size: 8.5px;
      font-weight: 600;
      letter-spacing: 0.26em;
      color: var(--text-muted);
      text-transform: uppercase;
      margin-top: 6px;
      transition: color 0.3s ease;
    }

    .brand-group:hover .brand-tagline {
      color: var(--accent-cyan);
    }

    .site-nav {
      display: flex;
      align-items: center;
      gap: 34px;
      margin-top: 2px;
    }

    .nav-link {
      font-size: 12.5px;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--text-muted);
      text-decoration: none;
      position: relative;
      padding: 6px 2px;
      transition: color 0.25s ease;
      cursor: pointer;
    }

    .nav-link:hover {
      color: var(--text-main);
    }

    .nav-link.active {
      color: var(--text-main);
    }

    .nav-link.active::after {
      content: '';
      position: absolute;
      bottom: -4px;
      left: 0;
      width: 100%;
      height: 2px;
      background: var(--accent-cyan);
      box-shadow: 0 0 10px var(--accent-cyan-glow);
      border-radius: 2px;
    }

    .nav-extras {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-left: 12px;
      border-left: 1px solid var(--panel-border);
      padding-left: 18px;
    }

    .icon-btn {
      background: none;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      font-size: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color 0.2s, transform 0.2s;
    }

    .icon-btn:hover {
      color: var(--accent-cyan);
      transform: scale(1.1);
    }

    /* ==========================================================================
       MAIN CONTENT LAYOUT (SPLIT HERO + DASHBOARD PANELS)
       ========================================================================== */
    .main-stage {
      flex: 1;
      display: grid;
      grid-template-columns: minmax(360px, 1fr) 640px;
      gap: 36px;
      align-items: flex-end;
      padding-bottom: 6px;
      z-index: 15;
    }

    /* ==========================================================================
       HERO SECTION (LEFT COLUMN - IN DEEP SPACE ABOVE EARTH'S LIMB)
       ========================================================================== */
    .hero-container {
      display: flex;
      flex-direction: column;
      justify-content: center;
      max-width: 480px;
      margin-bottom: 26px;
      pointer-events: auto;
    }

    .orbit-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      border-radius: 999px;
      background: rgba(8, 14, 24, 0.72);
      backdrop-filter: var(--glass-blur);
      border: 1px solid rgba(100, 210, 255, 0.22);
      width: fit-content;
      margin-bottom: 24px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    }

    .live-dot {
      width: 6.5px;
      height: 6.5px;
      border-radius: 50%;
      background-color: var(--accent-green);
      box-shadow: 0 0 10px var(--accent-green);
      animation: pulse-live 2s infinite ease-in-out;
    }

    @keyframes pulse-live {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.35; transform: scale(0.85); }
    }

    .badge-text {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.18em;
      color: #dbe7f5;
      text-transform: uppercase;
    }

    .satellite-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background-color: var(--accent-amber);
      box-shadow: 0 0 8px var(--accent-amber);
    }

    .hero-title {
      font-family: var(--font-display);
      font-size: clamp(38px, 4.4vw, 64px);
      font-weight: 800;
      line-height: 1.05;
      letter-spacing: -0.015em;
      color: var(--text-main);
      text-transform: uppercase;
      margin-bottom: 22px;
      text-shadow: 0 4px 30px rgba(0, 0, 0, 0.9);
    }

    .hero-subtitle {
      font-size: 14.5px;
      line-height: 1.65;
      color: var(--text-muted);
      max-width: 420px;
      margin-bottom: 34px;
      font-weight: 400;
      text-shadow: 0 2px 12px rgba(0, 0, 0, 0.85);
    }

    .cta-button {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      background: #ffffff;
      color: #020409;
      font-family: var(--font-body);
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      padding: 13px 28px;
      border-radius: 999px;
      border: none;
      cursor: pointer;
      text-decoration: none;
      width: fit-content;
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, background 0.25s ease;
      box-shadow: 0 4px 25px rgba(255, 255, 255, 0.22), 0 0 40px rgba(100, 210, 255, 0.15);
    }

    .cta-button:hover {
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 8px 32px rgba(255, 255, 255, 0.35), 0 0 50px rgba(100, 210, 255, 0.3);
      background: #f0f7ff;
    }

    .cta-button .arrow {
      font-size: 14px;
      transition: transform 0.25s ease;
    }

    .cta-button:hover .arrow {
      transform: translateX(4px);
    }

    /* ==========================================================================
       RIGHT COLUMN (TOP PANELS + FEATURE CARD VIEWER)
       ========================================================================== */
    .dashboard-container {
      display: flex;
      flex-direction: column;
      gap: 16px;
      pointer-events: auto;
      width: 640px;
      margin-left: auto;
    }

    /* ==========================================================================
       TOP PANELS ROW: LATEST FROM SPACE + UPCOMING
       ========================================================================== */
    .top-panels-row {
      display: grid;
      grid-template-columns: 384px 240px;
      gap: 16px;
      width: 100%;
    }

    .glass-panel {
      background: var(--panel-bg);
      backdrop-filter: var(--glass-blur);
      -webkit-backdrop-filter: var(--glass-blur);
      border: 1px solid var(--panel-border);
      border-radius: var(--panel-radius);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
      transition: var(--transition-smooth);
    }

    .glass-panel:hover {
      border-color: var(--panel-border-hover);
      box-shadow: 0 20px 48px rgba(0, 0, 0, 0.55), 0 0 24px rgba(100, 210, 255, 0.08);
    }

    /* Latest News Panel */
    .news-panel {
      padding: 15px 18px 14px 18px;
      display: flex;
      flex-direction: column;
    }

    .panel-header-title {
      font-size: 9.5px;
      font-weight: 700;
      letter-spacing: 0.16em;
      color: var(--text-muted);
      text-transform: uppercase;
      margin-bottom: 11px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .news-list {
      display: flex;
      flex-direction: column;
      gap: 9px;
    }

    .news-item {
      display: grid;
      grid-template-columns: 46px 1fr 34px;
      gap: 12px;
      align-items: center;
      padding: 3px 2px;
      border-radius: 8px;
      transition: background 0.2s ease;
      cursor: pointer;
      text-decoration: none;
    }

    .news-item:hover {
      background: rgba(255, 255, 255, 0.04);
    }

    .news-thumb {
      width: 46px;
      height: 35px;
      border-radius: 6px;
      object-fit: cover;
      background: #08111e;
      border: 1px solid rgba(255, 255, 255, 0.09);
    }

    .news-text {
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .news-title {
      font-size: 11px;
      font-weight: 600;
      color: var(--text-main);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      line-height: 1.3;
    }

    .news-meta {
      font-size: 9px;
      color: var(--text-dim);
      margin-top: 2px;
    }

    .news-badge-img {
      width: 32px;
      height: 25px;
      border-radius: 4px;
      object-fit: cover;
      opacity: 0.85;
      justify-self: end;
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    /* Upcoming Events Panel */
    .upcoming-panel {
      padding: 15px 18px 14px 18px;
      display: flex;
      flex-direction: column;
    }

    .upcoming-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .upcoming-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 3px 2px;
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.2s ease;
    }

    .upcoming-item:hover {
      background: rgba(255, 255, 255, 0.04);
    }

    .upcoming-visual {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      position: relative;
    }

    .upcoming-visual.eclipse {
      background: radial-gradient(circle, #020408 48%, #ffaa33 55%, transparent 68%);
      box-shadow: 0 0 10px rgba(255, 170, 51, 0.4);
    }

    .upcoming-visual.meteor {
      background: radial-gradient(circle, #64d2ff 10%, #153860 60%, transparent 80%);
      box-shadow: 0 0 10px rgba(100, 210, 255, 0.4);
    }

    .upcoming-visual.planets {
      background: radial-gradient(circle, #ffd166 20%, #994422 65%, transparent 75%);
      box-shadow: 0 0 10px rgba(255, 209, 102, 0.3);
    }

    .upcoming-info {
      display: flex;
      flex-direction: column;
    }

    .upcoming-title {
      font-size: 11px;
      font-weight: 600;
      color: var(--text-main);
      line-height: 1.25;
    }

    .upcoming-date {
      font-size: 9px;
      color: var(--text-dim);
      margin-top: 2px;
    }

    /* ==========================================================================
       MAIN FEATURE CARD VIEWPORT / CAROUSEL
       ========================================================================== */
    .feature-panel {
      position: relative;
      padding: 18px 20px 16px 20px;
      background: var(--panel-bg);
      backdrop-filter: var(--glass-blur);
      -webkit-backdrop-filter: var(--glass-blur);
      border: 1px solid var(--panel-border);
      border-radius: var(--panel-radius);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      width: 640px;
    }

    .feature-panel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }

    .feature-header-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .feature-title {
      font-size: 9.5px;
      font-weight: 700;
      letter-spacing: 0.16em;
      color: var(--text-muted);
      text-transform: uppercase;
      transition: opacity 0.2s ease;
    }

    .set-indicators {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .set-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.2);
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .set-dot.active {
      background: var(--accent-cyan);
      box-shadow: 0 0 8px var(--accent-cyan);
      width: 14px;
      border-radius: 999px;
    }

    .scroll-hint {
      font-size: 8.5px;
      font-weight: 600;
      letter-spacing: 0.12em;
      color: var(--text-dim);
      text-transform: uppercase;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .scroll-hint-arrow {
      animation: float-down 1.8s infinite ease-in-out;
    }

    @keyframes float-down {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(3px); }
    }

    /* Card Grid & Carousel Stage */
    .feature-stage-wrap {
      display: flex;
      position: relative;
      gap: 12px;
    }

    .cards-grid-container {
      flex: 1;
      position: relative;
      height: 338px;
      overflow: hidden;
    }

    .card-set {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: repeat(3, 102px);
      gap: 12px;
      opacity: 0;
      pointer-events: none;
      transform: translateY(30px) scale(0.98);
      filter: blur(8px);
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                  opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                  filter 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .card-set.active {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }

    .card-set.exit-up {
      opacity: 0;
      pointer-events: none;
      transform: translateY(-30px) scale(0.98);
      filter: blur(8px);
    }

    .card-set.exit-down {
      opacity: 0;
      pointer-events: none;
      transform: translateY(30px) scale(0.98);
      filter: blur(8px);
    }

    /* Individual Feature Card (Matching master screenshot) */
    .feature-card {
      position: relative;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: var(--card-radius);
      padding: 12px 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      overflow: hidden;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                  border-color 0.3s ease,
                  box-shadow 0.3s ease,
                  background-color 0.3s ease;
    }

    .feature-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: radial-gradient(800px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255, 255, 255, 0.08), transparent 40%);
      opacity: 0;
      transition: opacity 0.3s ease;
      pointer-events: none;
    }

    .feature-card:hover {
      transform: translateY(-2px) scale(1.015);
      border-color: var(--card-border-hover);
      background: rgba(16, 26, 40, 0.75);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5), 0 0 20px rgba(100, 210, 255, 0.12);
    }

    .feature-card:hover::before {
      opacity: 1;
    }

    .card-content {
      display: flex;
      flex-direction: column;
      justify-content: center;
      max-width: 58%;
      z-index: 2;
    }

    .card-title {
      font-family: var(--font-body);
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.1em;
      color: var(--text-main);
      text-transform: uppercase;
      line-height: 1.25;
      margin-bottom: 4px;
    }

    .card-desc {
      font-size: 9.5px;
      font-weight: 400;
      line-height: 1.4;
      color: var(--text-muted);
    }

    .card-visual {
      width: 98px;
      height: 78px;
      border-radius: 8px;
      overflow: hidden;
      position: relative;
      flex-shrink: 0;
      z-index: 1;
      border: 1px solid rgba(255, 255, 255, 0.09);
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.35);
      background: #040913;
    }

    .card-visual canvas {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.5s ease;
    }

    .feature-card:hover .card-visual canvas {
      transform: scale(1.08);
    }

    /* Sleek Vertical Scroll Indicator Track (Right Edge) */
    .vertical-scrollbar {
      width: 4px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 4px;
      position: relative;
      cursor: pointer;
      margin-left: 2px;
      height: 338px;
    }

    .scrollbar-thumb {
      width: 100%;
      height: 33.333%;
      background: rgba(255, 255, 255, 0.7);
      border-radius: 4px;
      position: absolute;
      top: 33.333%; /* Default to Set 1 (Featured) */
      left: 0;
      box-shadow: 0 0 10px rgba(255, 255, 255, 0.4);
      transition: top 0.4s cubic-bezier(0.16, 1, 0.3, 1), background 0.2s ease;
    }

    .vertical-scrollbar:hover .scrollbar-thumb {
      background: var(--accent-cyan);
      box-shadow: 0 0 12px var(--accent-cyan-glow);
    }

    /* ==========================================================================
       MISSION DOSSIER / INTERACTIVE MODAL DIALOG
       ========================================================================== */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(2, 6, 14, 0.82);
      backdrop-filter: blur(28px);
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .modal-overlay.open {
      opacity: 1;
      pointer-events: auto;
    }

    .modal-window {
      width: min(640px, 92vw);
      background: rgba(11, 18, 30, 0.95);
      border: 1px solid rgba(100, 210, 255, 0.3);
      border-radius: 20px;
      padding: 32px;
      box-shadow: 0 25px 80px rgba(0, 0, 0, 0.8), 0 0 40px rgba(100, 210, 255, 0.15);
      transform: scale(0.92) translateY(20px);
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
    }

    .modal-overlay.open .modal-window {
      transform: scale(1) translateY(0);
    }

    .modal-close-btn {
      position: absolute;
      top: 20px;
      right: 20px;
      background: rgba(255, 255, 255, 0.08);
      border: none;
      color: var(--text-muted);
      width: 32px;
      height: 32px;
      border-radius: 50%;
      cursor: pointer;
      display: grid;
      place-items: center;
      font-size: 16px;
      transition: all 0.2s ease;
    }

    .modal-close-btn:hover {
      background: rgba(255, 255, 255, 0.2);
      color: #fff;
    }

    .modal-tag {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.2em;
      color: var(--accent-cyan);
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    .modal-title {
      font-family: var(--font-display);
      font-size: 28px;
      font-weight: 800;
      letter-spacing: 0.02em;
      color: #fff;
      margin-bottom: 14px;
    }

    .modal-body {
      font-size: 13.5px;
      line-height: 1.7;
      color: var(--text-muted);
      margin-bottom: 24px;
    }

    .modal-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 28px;
      background: rgba(255, 255, 255, 0.03);
      padding: 16px;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.06);
    }

    .stat-box {
      display: flex;
      flex-direction: column;
    }

    .stat-label {
      font-size: 9.5px;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--text-dim);
    }

    .stat-value {
      font-family: var(--font-display);
      font-size: 16px;
      font-weight: 700;
      color: var(--accent-cyan);
      margin-top: 4px;
    }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 12px;
    }

    .modal-btn-secondary {
      padding: 10px 20px;
      border-radius: 999px;
      background: transparent;
      border: 1px solid var(--panel-border);
      color: var(--text-muted);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.1em;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .modal-btn-secondary:hover {
      border-color: rgba(255, 255, 255, 0.3);
      color: #fff;
    }

    .modal-btn-primary {
      padding: 10px 24px;
      border-radius: 999px;
      background: var(--accent-cyan);
      color: #030710;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.12em;
      border: none;
      cursor: pointer;
      box-shadow: 0 0 20px var(--accent-cyan-glow);
      transition: all 0.2s ease;
    }

    .modal-btn-primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 0 30px var(--accent-cyan-glow);
      background: #89e0ff;
    }

    /* ==========================================================================
       RESPONSIVE BREAKPOINTS
       ========================================================================== */
    @media (max-width: 1280px) {
      .app-viewport {
        padding: 24px 36px 26px 36px;
      }
      .main-stage {
        grid-template-columns: 1fr 600px;
        gap: 24px;
      }
      .dashboard-container, .feature-panel {
        width: 600px;
      }
      .top-panels-row {
        grid-template-columns: 360px 224px;
      }
    }

    @media (max-width: 1080px) {
      html, body {
        overflow-y: auto;
        user-select: auto;
      }
      .app-viewport {
        height: auto;
        min-height: 100vh;
        overflow: visible;
        padding: 24px;
        gap: 40px;
      }
      .main-stage {
        grid-template-columns: 1fr;
        align-items: flex-start;
      }
      .hero-container {
        max-width: 600px;
        margin-bottom: 24px;
      }
      .dashboard-container, .feature-panel {
        margin-left: 0;
        width: 100%;
        max-width: 650px;
      }
      .top-panels-row {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 768px) {
      .site-header {
        flex-direction: column;
        gap: 16px;
      }
      .site-nav {
        flex-wrap: wrap;
        gap: 16px;
      }
      .top-panels-row {
        grid-template-columns: 1fr;
      }
      .card-set {
        grid-template-columns: 1fr;
        grid-template-rows: repeat(6, 92px);
        height: 610px;
      }
      .cards-grid-container, .vertical-scrollbar {
        height: 610px;
      }
    }

    /* Accessibility: Reduced Motion */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body>

  <!-- Ambient Space Dust Gradients -->
  <div class="space-backdrop"></div>

  <!-- Three.js WebGL Container -->
  <canvas id="webgl-canvas"></canvas>

  <!-- Main Viewport Overlay -->
  <div class="app-viewport">
    
    <!-- Top Site Header (Exact Master Reference) -->
    <header class="site-header interactive-element">
      <a href="#" class="brand-group" id="brand-link" title="ASTRA - Space Exploration Dashboard">
        <span class="brand-logo">ASTRA</span>
        <span class="brand-tagline">EXPLORE THE UNIVERSE</span>
      </a>

      <nav class="site-nav" aria-label="Main Navigation">
        <a href="#home" class="nav-link active" data-nav="home">HOME</a>
        <a href="#explore" class="nav-link" data-nav="explore">EXPLORE</a>
        <a href="#events" class="nav-link" data-nav="events">EVENTS</a>
        <a href="#games" class="nav-link" data-nav="games">GAMES</a>
        <a href="#about" class="nav-link" data-nav="about">ABOUT</a>

        <div class="nav-extras">
          <button class="icon-btn" id="audio-toggle" title="Toggle Ambient Orbit Sound" aria-label="Toggle Sound">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
              <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
            </svg>
          </button>
          <button class="icon-btn" id="fs-toggle" title="Toggle Fullscreen" aria-label="Toggle Fullscreen">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <!-- Main Hero & Dashboard Area -->
    <main class="main-stage">
      
      <!-- Hero Left Area (In Deep Space Above Earth's Limb) -->
      <section class="hero-container interactive-element">
        <div class="orbit-badge">
          <span class="live-dot"></span>
          <span class="badge-text">LIVE • EARTH ORBIT</span>
          <span class="satellite-dot"></span>
        </div>

        <h1 class="hero-title">
          THE UNIVERSE<br>
          IS CLOSER THAN<br>
          YOU THINK.
        </h1>

        <p class="hero-subtitle">
          Explore planets, galaxies, cosmic events<br>and the mysteries beyond Earth.
        </p>

        <a href="#explore" class="cta-button" id="start-explore-btn">
          <span>START EXPLORING</span>
          <span class="arrow">→</span>
        </a>
      </section>

      <!-- Right Dashboard Area -->
      <section class="dashboard-container interactive-element" id="dashboard-area">
        
        <!-- Top Panels Row: Latest from Space & Upcoming -->
        <div class="top-panels-row">
          
          <!-- Latest from Space Panel -->
          <article class="glass-panel news-panel">
            <div class="panel-header-title">
              <span>LATEST FROM SPACE</span>
            </div>

            <div class="news-list">
              <!-- News Item 1 -->
              <div class="news-item" data-modal="news-1">
                <canvas class="news-thumb" id="news-canvas-1" width="92" height="70"></canvas>
                <div class="news-text">
                  <span class="news-title">Earth Observation Updates</span>
                  <span class="news-meta">2024 • 3 min read</span>
                </div>
                <canvas class="news-badge-img" id="news-badge-1" width="64" height="50"></canvas>
              </div>

              <!-- News Item 2 -->
              <div class="news-item" data-modal="news-2">
                <canvas class="news-thumb" id="news-canvas-2" width="92" height="70"></canvas>
                <div class="news-text">
                  <span class="news-title">Perseid Meteor Peak</span>
                  <span class="news-meta">2024 • 2 min read</span>
                </div>
                <canvas class="news-badge-img" id="news-badge-2" width="64" height="50"></canvas>
              </div>

              <!-- News Item 3 -->
              <div class="news-item" data-modal="news-3">
                <canvas class="news-thumb" id="news-canvas-3" width="92" height="70"></canvas>
                <div class="news-text">
                  <span class="news-title">Planetary Neighbourhood</span>
                  <span class="news-meta">2024 • 4 min read</span>
                </div>
                <canvas class="news-badge-img" id="news-badge-3" width="64" height="50"></canvas>
              </div>
            </div>
          </article>

          <!-- Upcoming Astronomical Events Panel -->
          <article class="glass-panel upcoming-panel">
            <div class="panel-header-title">
              <span>UPCOMING</span>
            </div>

            <div class="upcoming-list">
              <!-- Event 1: Solar Eclipse -->
              <div class="upcoming-item" data-modal="upcoming-1">
                <div class="upcoming-visual eclipse"></div>
                <div class="upcoming-info">
                  <span class="upcoming-title">Solar Eclipse</span>
                  <span class="upcoming-date">June 21, 2025</span>
                </div>
              </div>

              <!-- Event 2: Meteor Shower -->
              <div class="upcoming-item" data-modal="upcoming-2">
                <div class="upcoming-visual meteor"></div>
                <div class="upcoming-info">
                  <span class="upcoming-title">Meteor Shower</span>
                  <span class="upcoming-date">June 14, 2024</span>
                </div>
              </div>

              <!-- Event 3: Planetary Alignment -->
              <div class="upcoming-item" data-modal="upcoming-3">
                <div class="upcoming-visual planets"></div>
                <div class="upcoming-info">
                  <span class="upcoming-title">Planetary Alignment</span>
                  <span class="upcoming-date">May 13, 2025</span>
                </div>
              </div>
            </div>
          </article>
        </div>

        <!-- Main Feature Card Carousel Viewport (Lower Right, Fixed Viewport) -->
        <article class="feature-panel" id="feature-viewport">
          <div class="feature-panel-header">
            <div class="feature-header-left">
              <span class="feature-title" id="feature-panel-title">FEATURED EVENTS</span>
              <div class="set-indicators" id="set-dots-group">
                <span class="set-dot" data-set="0" title="Set 1: Solar System & Exploration"></span>
                <span class="set-dot active" data-set="1" title="Set 2: Exoplanets & Cosmos (Featured Master)"></span>
                <span class="set-dot" data-set="2" title="Set 3: Deep Cosmos & Horizons"></span>
              </div>
            </div>
            <div class="scroll-hint">
              <span>SCROLL TO CYCLE</span>
              <span class="scroll-hint-arrow">↓</span>
            </div>
          </div>

          <div class="feature-stage-wrap">
            <div class="cards-grid-container" id="cards-grid-container">
              
              <!-- SET 0: SOLAR SYSTEM & CORE EXPERIENCES -->
              <div class="card-set" id="card-set-0" data-set-index="0">
                <div class="feature-card" data-slug="solar-system">
                  <div class="card-content">
                    <span class="card-title">SOLAR SYSTEM</span>
                    <span class="card-desc">Explore our planetary neighbourhood.</span>
                  </div>
                  <div class="card-visual"><canvas id="art-solar-system" width="196" height="156"></canvas></div>
                </div>

                <div class="feature-card" data-slug="space-predictions">
                  <div class="card-content">
                    <span class="card-title">SPACE PREDICTIONS</span>
                    <span class="card-desc">See what's happening next in orbit.</span>
                  </div>
                  <div class="card-visual"><canvas id="art-predictions" width="196" height="156"></canvas></div>
                </div>

                <div class="feature-card" data-slug="asteroid-collision">
                  <div class="card-content">
                    <span class="card-title">ASTEROID COLLISION</span>
                    <span class="card-desc">Can you protect Earth from impacts?</span>
                  </div>
                  <div class="card-visual"><canvas id="art-asteroid" width="196" height="156"></canvas></div>
                </div>

                <div class="feature-card" data-slug="galaxies">
                  <div class="card-content">
                    <span class="card-title">GALAXIES</span>
                    <span class="card-desc">Travel beyond our solar system.</span>
                  </div>
                  <div class="card-visual"><canvas id="art-galaxies" width="196" height="156"></canvas></div>
                </div>

                <div class="feature-card" data-slug="cosmic-explorer">
                  <div class="card-content">
                    <span class="card-title">COSMIC EXPLORER</span>
                    <span class="card-desc">Interactive orbital flight simulator.</span>
                  </div>
                  <div class="card-visual"><canvas id="art-explorer" width="196" height="156"></canvas></div>
                </div>

                <div class="feature-card" data-slug="more-to-explore">
                  <div class="card-content">
                    <span class="card-title">MORE TO EXPLORE</span>
                    <span class="card-desc">Uncharted frontiers & deep space.</span>
                  </div>
                  <div class="card-visual"><canvas id="art-more" width="196" height="156"></canvas></div>
                </div>
              </div>

              <!-- SET 1: EXACT MATCH TO REFERENCE SCREENSHOT -->
              <div class="card-set active" id="card-set-1" data-set-index="1">
                <!-- Card 1: Exoplanets -->
                <div class="feature-card" data-slug="exoplanets">
                  <div class="card-content">
                    <span class="card-title">EXOPLANETS</span>
                    <span class="card-desc">Explore worlds orbiting distant stars.</span>
                  </div>
                  <div class="card-visual"><canvas id="art-exoplanets" width="196" height="156"></canvas></div>
                </div>

                <!-- Card 2: Solar Activity -->
                <div class="feature-card" data-slug="solar-activity">
                  <div class="card-content">
                    <span class="card-title">SOLAR ACTIVITY</span>
                    <span class="card-desc">Understand what is happening on our Sun.</span>
                  </div>
                  <div class="card-visual"><canvas id="art-solar-activity" width="196" height="156"></canvas></div>
                </div>

                <!-- Card 3: Space Missions -->
                <div class="feature-card" data-slug="space-missions">
                  <div class="card-content">
                    <span class="card-title">SPACE MISSIONS</span>
                    <span class="card-desc">Follow humanity's journey beyond Earth.</span>
                  </div>
                  <div class="card-visual"><canvas id="art-space-missions" width="196" height="156"></canvas></div>
                </div>

                <!-- Card 4: Constellations -->
                <div class="feature-card" data-slug="constellations">
                  <div class="card-content">
                    <span class="card-title">CONSTELLATIONS</span>
                    <span class="card-desc">Discover patterns across the night sky.</span>
                  </div>
                  <div class="card-visual"><canvas id="art-constellations" width="196" height="156"></canvas></div>
                </div>

                <!-- Card 5: Deep Space -->
                <div class="feature-card" data-slug="deep-space">
                  <div class="card-content">
                    <span class="card-title">DEEP SPACE</span>
                    <span class="card-desc">Explore nebulae, star clusters and distant galaxies.</span>
                  </div>
                  <div class="card-visual"><canvas id="art-deep-space" width="196" height="156"></canvas></div>
                </div>

                <!-- Card 6: Cosmic Timeline -->
                <div class="feature-card" data-slug="cosmic-timeline">
                  <div class="card-content">
                    <span class="card-title">COSMIC TIMELINE</span>
                    <span class="card-desc">Travel through the major events of the universe.</span>
                  </div>
                  <div class="card-visual"><canvas id="art-cosmic-timeline" width="196" height="156"></canvas></div>
                </div>
              </div>

              <!-- SET 2: DEEP COSMIC HORIZONS -->
              <div class="card-set" id="card-set-2" data-set-index="2">
                <div class="feature-card" data-slug="black-holes">
                  <div class="card-content">
                    <span class="card-title">BLACK HOLES</span>
                    <span class="card-desc">Singularities bending spacetime itself.</span>
                  </div>
                  <div class="card-visual"><canvas id="art-black-holes" width="196" height="156"></canvas></div>
                </div>

                <div class="feature-card" data-slug="nebulae">
                  <div class="card-content">
                    <span class="card-title">NEBULAE</span>
                    <span class="card-desc">Stellar nurseries glowing with cosmic gas.</span>
                  </div>
                  <div class="card-visual"><canvas id="art-nebulae" width="196" height="156"></canvas></div>
                </div>

                <div class="feature-card" data-slug="supernovae">
                  <div class="card-content">
                    <span class="card-title">SUPERNOVAE</span>
                    <span class="card-desc">Cataclysmic stellar detonations.</span>
                  </div>
                  <div class="card-visual"><canvas id="art-supernovae" width="196" height="156"></canvas></div>
                </div>

                <div class="feature-card" data-slug="star-clusters">
                  <div class="card-content">
                    <span class="card-title">STAR CLUSTERS</span>
                    <span class="card-desc">Ancient gravitational swarms of stars.</span>
                  </div>
                  <div class="card-visual"><canvas id="art-star-clusters" width="196" height="156"></canvas></div>
                </div>

                <div class="feature-card" data-slug="spacecraft">
                  <div class="card-content">
                    <span class="card-title">SPACECRAFT</span>
                    <span class="card-desc">Pioneering voyagers venturing into the void.</span>
                  </div>
                  <div class="card-visual"><canvas id="art-spacecraft" width="196" height="156"></canvas></div>
                </div>

                <div class="feature-card" data-slug="future-discovery">
                  <div class="card-content">
                    <span class="card-title">FUTURE DISCOVERY</span>
                    <span class="card-desc">Next-generation gravitational detectors.</span>
                  </div>
                  <div class="card-visual"><canvas id="art-future-discovery" width="196" height="156"></canvas></div>
                </div>
              </div>

            </div>

            <!-- Scrollbar Track & Thumb -->
            <div class="vertical-scrollbar" id="scrollbar-track" title="Click or drag to switch sets">
              <div class="scrollbar-thumb" id="scrollbar-thumb"></div>
            </div>
          </div>
        </article>

      </section>

    </main>

  </div>

  <!-- Interactive Mission Dossier / Topic Dialog -->
  <div class="modal-overlay" id="mission-modal" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="modal-window">
      <button class="modal-close-btn" id="modal-close-btn" aria-label="Close dialog">✕</button>
      <div class="modal-tag" id="modal-tag">MISSION DOSSIER</div>
      <h2 class="modal-title" id="modal-title">EXOPLANETS</h2>
      <p class="modal-body" id="modal-body">
        Explore worlds orbiting stars beyond our Solar System. From scorched 'hot Jupiters' to ocean-covered super-Earths, over 5,500 exoplanets have been confirmed by space telescopes like Kepler, TESS, and James Webb.
      </p>

      <div class="modal-stats" id="modal-stats">
        <div class="stat-box">
          <span class="stat-label">Confirmed Worlds</span>
          <span class="stat-value">5,632</span>
        </div>
        <div class="stat-box">
          <span class="stat-label">Habitable Candidates</span>
          <span class="stat-value">168</span>
        </div>
        <div class="stat-box">
          <span class="stat-label">Observation Depth</span>
          <span class="stat-value">28,000 ly</span>
        </div>
      </div>

      <div class="modal-actions">
        <button class="modal-btn-secondary" id="modal-back-btn">Close</button>
        <button class="modal-btn-primary" id="modal-action-btn">Launch Exploration Module →</button>
      </div>
    </div>
  </div>

  <!-- ==========================================================================
       ASTRA — ASTEROID COLLISION SIMULATION EXPERIENCE
       Integrated AAA Space Simulation & Scientific Impact Analysis Module
       ========================================================================== -->
  <div id="asteroid-collision-experience" class="collision-experience" aria-hidden="true" style="display: none;">
    <!-- Dedicated 3D WebGL Canvas for Collision Cinematic -->
    <canvas id="collision-webgl-canvas"></canvas>

    <!-- Global Aerospace Navigation Header -->
    <header class="sim-nav-header" id="sim-nav-header">
      <div class="sim-nav-left sim-interactive">
        <button class="sim-brand-btn" id="sim-nav-brand" title="Return to ASTRA Home">
          <span class="sim-brand-title">ASTRA</span>
          <span class="sim-brand-subtitle">ORBITAL DEFENSE INITIATIVE</span>
        </button>
        <button class="sim-home-btn" id="btn-global-home" title="Return to ASTRA Home">
          <span>⌂ BACK TO HOME</span>
        </button>
        <button class="sim-back-btn" id="sim-nav-back" title="Go back to previous stage">
          <span>← BACK</span>
        </button>
      </div>

      <div class="sim-stage-tracker sim-interactive">
        <span class="tracker-dot"></span>
        <span class="tracker-label" id="sim-tracker-label">ASTRA ORBITAL CONTROL // 01 INTRO</span>
      </div>

      <div class="sim-nav-right sim-interactive">
        <button class="sim-icon-btn" id="sim-fullscreen-btn" title="Toggle Fullscreen" aria-label="Fullscreen">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
          </svg>
        </button>
      </div>
    </header>

    <!-- Stage Container -->
    <main class="sim-stage-container">
      
      <!-- STAGE 1: COCKPIT HUD (MATCHING STORYBOARD PANEL 1) -->
      <section class="sim-stage-view active" id="view-intro">
        <div class="cockpit-frame-container">
          <!-- Left Telemetry Monitor -->
          <div class="dark-glass-panel cockpit-monitor">
            <div>
              <div class="monitor-header">
                <span>ORBITAL MONITOR</span>
                <span style="color: #00e699;">LIVE</span>
              </div>
              <div class="hud-data-row">
                <span class="hud-data-label">SURVEILLANCE</span>
                <span class="hud-data-val">CNEOS / SENTRY</span>
              </div>
              <div class="hud-data-row">
                <span class="hud-data-label">TRACKED NEOS</span>
                <span class="hud-data-val">34,890 BODIES</span>
              </div>
              <div class="hud-data-row">
                <span class="hud-data-label">KNOWN PHAS</span>
                <span class="hud-data-val">2,412 OBJECTS</span>
              </div>
              <div class="hud-data-row">
                <span class="hud-data-label">RADAR STATUS</span>
                <span class="hud-data-val" style="color: #64d2ff;">ACTIVE SEARCH</span>
              </div>
            </div>
            <div>
              <div style="font-size: 8.5px; color: #8ca2b9; letter-spacing: 0.12em; line-height: 1.5; border-top: 1px solid rgba(100, 210, 255, 0.15); padding-top: 10px;">
                NASA / JPL SBDB TELEMETRY FEEDS SYNCHRONIZED. PLANETARY DEFENSE MONITOR ONLINE.
              </div>
            </div>
          </div>

          <!-- Center Cinematic Viewport Overlay -->
          <div class="cockpit-center-viewport">
            <h1 class="cockpit-title">ASTEROID COLLISION<br><span style="color: #64d2ff;">PLANETARY IMPACT SIMULATOR</span></h1>
            <p class="cockpit-desc">
              Engage high-precision orbital mechanics, peer-reviewed impact physics, and real NASA/JPL Near-Earth Object telemetry to evaluate hypothetical collision consequences on Earth.
            </p>
            <button class="primary-cta-btn" id="btn-intro-proceed">
              <span>COMMENCE TARGETING &amp; IMPACT ANALYSIS</span>
              <span>→</span>
            </button>
          </div>

          <!-- Right Telemetry Monitor -->
          <div class="dark-glass-panel cockpit-monitor">
            <div>
              <div class="monitor-header">
                <span>PHYSICS PIPELINE</span>
                <span style="color: #64d2ff;">CALIBRATED</span>
              </div>
              <div class="hud-data-row">
                <span class="hud-data-label">SCALING ENGINE</span>
