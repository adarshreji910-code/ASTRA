  <!-- ==========================================================================
       JAVASCRIPT LOGIC
       1. Three.js Photorealistic 3D Earth, Cloud Sphere, Atmosphere Shader & Orbit Path
       2. Realistic Artwork Generation on Canvases (Zero Broken Images/Zero CORS Issues)
       3. Scroll-Controlled Feature Card Carousel (Directional Transitions & Wheel Lock)
       4. Card Pointer Parallax & Interactive Mission Dossiers
       5. Ambient Audio Synthesizer (Web Audio API)
       ========================================================================== -->
  <script>
  (function() {
    'use strict';

    /* ==========================================================================
       1. THREE.JS 3D EARTH SIMULATION (INDEPENDENT ROTATION & ACCURATE COMPOSITION)
       ========================================================================== */
    const canvas = document.getElementById('webgl-canvas');
    let renderer, scene, camera, earthMesh, cloudMesh, innerAtmosphereMesh, outerAtmosphereMesh;
    let orbitLine, satelliteMesh1, satelliteMesh2;
    let clock = new THREE.Clock();

    function initThree() {
      // Scene
      scene = new THREE.Scene();

      // Camera: Low-orbit perspective matching master screenshot
      const aspect = window.innerWidth / window.innerHeight;
      camera = new THREE.PerspectiveCamera(40, aspect, 0.1, 1000);
      updateCameraPosition();

      // Renderer
      renderer = new THREE.WebGLRenderer({
        canvas: canvas,
        antialias: true,
        alpha: true,
        powerPreference: 'high-performance'
      });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.15;

      // Lights: Directional sunlight casting from upper-left
      const sunLight = new THREE.DirectionalLight(0xffffff, 2.3);
      sunLight.position.set(-6, 4.2, 5.5);
      scene.add(sunLight);

      // Night-side ambient fill (dark space navy)
      const ambientLight = new THREE.AmbientLight(0x030a16, 0.35);
      scene.add(ambientLight);

      // Cyan rim fill for Rayleigh atmospheric reflection
      const rimLight = new THREE.DirectionalLight(0x40a0ff, 0.85);
      rimLight.position.set(4, 2, -2);
      scene.add(rimLight);

      // Build 3D Universe
      createStarfield();
      createEarth();
      createSatelliteOrbit();

      window.addEventListener('resize', onWindowResize, false);

      // Start independent animation loop
      animate();
    }

    function updateCameraPosition() {
      const w = window.innerWidth;
      // Precision positioning:
      // Earth limb sweeps from lower left (behind CTA button)
      // to center-right (underneath headline and panels)
      if (w > 1200) {
        camera.position.set(0, 0, 5.0);
      } else if (w > 768) {
        camera.position.set(0.1, 0.1, 5.4);
      } else {
        camera.position.set(0.2, 0.2, 5.8);
      }
      camera.lookAt(0, -0.45, 0);
    }

    function onWindowResize() {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      updateCameraPosition();
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    }

    /* --------------------------------------------------------------------------
       Starfield & Nebula Dust Particles
       -------------------------------------------------------------------------- */
    function createStarfield() {
      const starCount = 2000;
      const geometry = new THREE.BufferGeometry();
      const positions = new Float32Array(starCount * 3);
      const colors = new Float32Array(starCount * 3);

      for (let i = 0; i < starCount; i++) {
        const i3 = i * 3;
        const radius = 45 + Math.random() * 85;
        const theta = Math.random() * Math.PI * 2;
        const phi = Math.acos((Math.random() * 2) - 1);

        positions[i3] = radius * Math.sin(phi) * Math.cos(theta);
        positions[i3 + 1] = radius * Math.sin(phi) * Math.sin(theta);
        positions[i3 + 2] = -Math.abs(radius * Math.cos(phi)) - 4;

        const colType = Math.random();
        if (colType > 0.86) {
          colors[i3] = 1.0; colors[i3 + 1] = 0.88; colors[i3 + 2] = 0.72; // Warm
        } else if (colType > 0.6) {
          colors[i3] = 0.72; colors[i3 + 1] = 0.9; colors[i3 + 2] = 1.0;  // Cyan/Blue
        } else {
          colors[i3] = 0.95; colors[i3 + 1] = 0.96; colors[i3 + 2] = 1.0;  // Pure White
        }
      }

      geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

      const starCanvas = document.createElement('canvas');
      starCanvas.width = 16;
      starCanvas.height = 16;
      const ctx = starCanvas.getContext('2d');
      const grad = ctx.createRadialGradient(8, 8, 0, 8, 8, 8);
      grad.addColorStop(0, 'rgba(255,255,255,1)');
      grad.addColorStop(0.35, 'rgba(255,255,255,0.75)');
      grad.addColorStop(1, 'rgba(255,255,255,0)');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, 16, 16);

      const starTex = new THREE.CanvasTexture(starCanvas);
      const starMaterial = new THREE.PointsMaterial({
        size: 0.95,
        vertexColors: true,
        map: starTex,
        transparent: true,
        opacity: 0.8,
        depthWrite: false
      });

      const stars = new THREE.Points(geometry, starMaterial);
      scene.add(stars);
    }

    /* --------------------------------------------------------------------------
       Photorealistic Procedural Earth Canvas Textures
       -------------------------------------------------------------------------- */
    function generateEarthDayTexture() {
      const c = document.createElement('canvas');
      c.width = 2048;
      c.height = 1024;
      const ctx = c.getContext('2d');

      // Deep Ocean Base
      const oceanGrad = ctx.createLinearGradient(0, 0, 0, c.height);
      oceanGrad.addColorStop(0, '#0a223d');
      oceanGrad.addColorStop(0.3, '#0d2d52');
      oceanGrad.addColorStop(0.5, '#0b2644');
      oceanGrad.addColorStop(0.8, '#081c33');
      oceanGrad.addColorStop(1, '#051224');
      ctx.fillStyle = oceanGrad;
      ctx.fillRect(0, 0, c.width, c.height);

      function drawContinent(paths, fillStyle, strokeStyle, strokeW = 4) {
        ctx.fillStyle = fillStyle;
        ctx.strokeStyle = strokeStyle;
        ctx.lineWidth = strokeW;
        paths.forEach(p => {
          ctx.beginPath();
          p.forEach((pt, idx) => {
            const x = (pt[0] / 360 + 0.5) * c.width;
            const y = (0.5 - pt[1] / 180) * c.height;
            if (idx === 0) ctx.moveTo(x, y);
            else ctx.lineTo(x, y);
          });
          ctx.closePath();
          ctx.fill();
          if (strokeStyle) ctx.stroke();
        });
      }

      // North America (Dominant continent facing camera in reference screenshot)
      const northAmerica = [[
        [-168, 65], [-162, 70], [-140, 71], [-120, 70], [-100, 71], [-80, 62],
        [-65, 52], [-60, 46], [-66, 44], [-75, 36], [-80, 26], [-90, 21],
        [-97, 26], [-105, 23], [-115, 30], [-124, 38], [-125, 49], [-136, 58],
        [-150, 61], [-168, 65]
      ]];
      drawContinent(northAmerica, '#4b5e3f', '#243b20', 6);

      // Central America & Baja
      const centralAmerica = [[
        [-97, 26], [-92, 17], [-84, 10], [-78, 8], [-80, 14], [-90, 20], [-97, 26]
      ]];
      drawContinent(centralAmerica, '#31542a', '#1e3819', 4);

      // South America
      const southAmerica = [[
        [-76, 11], [-62, 7], [-50, -1], [-35, -5], [-38, -15], [-50, -28],
        [-65, -45], [-72, -55], [-75, -45], [-70, -30], [-78, -15], [-81, -2], [-76, 11]
      ]];
      drawContinent(southAmerica, '#385732', '#223c1e', 5);

      // Europe
      const europe = [[
        [-10, 36], [0, 43], [12, 44], [22, 54], [30, 60], [42, 68],
        [32, 70], [16, 62], [6, 58], [-4, 50], [-10, 40], [-10, 36]
      ]];
      drawContinent(europe, '#4a593e', '#324227', 4);

      // Africa
      const africa = [[
        [-17, 30], [-5, 36], [10, 37], [25, 32], [32, 31], [43, 12], [51, 11],
        [42, -5], [35, -20], [28, -34], [18, -34], [12, -15], [9, 5], [-15, 12], [-17, 30]
      ]];
      drawContinent(africa, '#8c7042', '#6b5128', 5);

      // Asia & Siberia
      const asia = [[
        [30, 60], [60, 68], [90, 73], [120, 70], [150, 60], [170, 65],
        [160, 50], [140, 40], [120, 32], [105, 20], [100, 10], [80, 15],
        [70, 25], [60, 25], [50, 30], [35, 35], [30, 45], [30, 60]
      ]];
      drawContinent(asia, '#4c5237', '#343a22', 5);

      // India
      const india = [[ [68, 25], [77, 8], [88, 22], [80, 27], [68, 25] ]];
      drawContinent(india, '#41542f', '#2a3b1e', 4);

      // Australia
      const australia = [[
        [113, -22], [125, -15], [138, -12], [148, -20], [152, -30], [140, -38], [115, -34], [113, -22]
      ]];
      drawContinent(australia, '#9e6231', '#784319', 5);

      // Mountains & Relief
      ctx.fillStyle = '#6d685c';
      ctx.beginPath();
      ctx.ellipse((-112/360 + 0.5)*c.width, (0.5 - 45/180)*c.height, 16, 75, 0.35, 0, Math.PI*2);
      ctx.fill();
      ctx.beginPath();
      ctx.ellipse((-70/360 + 0.5)*c.width, (0.5 - -20/180)*c.height, 10, 90, 0.15, 0, Math.PI*2);
      ctx.fill();
      ctx.beginPath();
      ctx.ellipse((85/360 + 0.5)*c.width, (0.5 - 29/180)*c.height, 45, 10, -0.2, 0, Math.PI*2);
      ctx.fill();

      // Polar Ice Caps
      ctx.fillStyle = '#f0f8ff';
      ctx.fillRect(0, 0, c.width, c.height * 0.08);
      ctx.fillRect(0, c.height * 0.88, c.width, c.height * 0.12);

      // Shallow Shelf Glow
      ctx.strokeStyle = 'rgba(40, 185, 215, 0.35)';
      ctx.lineWidth = 6;
      ctx.stroke();

      const texture = new THREE.CanvasTexture(c);
      texture.wrapS = THREE.RepeatWrapping;
      texture.wrapT = THREE.ClampToEdgeWrapping;
      return texture;
    }

    function generateEarthCloudsTexture() {
      const c = document.createElement('canvas');
      c.width = 2048;
      c.height = 1024;
      const ctx = c.getContext('2d');

      ctx.clearRect(0, 0, c.width, c.height);

      for (let i = 0; i < 500; i++) {
        const x = Math.random() * c.width;
        const latZone = (Math.random() - 0.5) * 2;
        const y = (0.5 + latZone * 0.42) * c.height;
        const radX = 35 + Math.random() * 140;
        const radY = 12 + Math.random() * 40;
        const rot = (Math.random() - 0.5) * 0.8;

        const alpha = 0.12 + Math.random() * 0.5;
        ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;

        ctx.beginPath();
        ctx.ellipse(x, y, radX, radY, rot, 0, Math.PI * 2);
        ctx.fill();

        if (Math.random() > 0.55) {
          ctx.beginPath();
          ctx.ellipse(x + radX * 0.6, y + radY * 0.4, radX * 0.5, radY * 0.3, rot + 0.35, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      function drawCyclone(cx, cy, r) {
        for (let a = 0; a < Math.PI * 5; a += 0.2) {
          const dist = (a / (Math.PI * 5)) * r;
          const px = cx + Math.cos(a) * dist;
          const py = cy + Math.sin(a) * dist;
          ctx.fillStyle = `rgba(255, 255, 255, ${0.45 - (dist/r)*0.3})`;
          ctx.beginPath();
          ctx.arc(px, py, 6 + dist * 0.15, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      drawCyclone(c.width * 0.28, c.height * 0.42, 70);
      drawCyclone(c.width * 0.72, c.height * 0.38, 85);

      const texture = new THREE.CanvasTexture(c);
      texture.wrapS = THREE.RepeatWrapping;
      texture.wrapT = THREE.ClampToEdgeWrapping;
      return texture;
    }

    /* --------------------------------------------------------------------------
       Create Earth Meshes with Atmospheric Shader
       -------------------------------------------------------------------------- */
    function createEarth() {
      // Precision planetary geometry & scale
      // Radius and position tuned so the top limb sweeps below the hero text
      const earthRadius = 4.2;
      const sphereGeo = new THREE.SphereGeometry(earthRadius, 64, 64);

      const earthDayTex = generateEarthDayTexture();
      const earthCloudTex = generateEarthCloudsTexture();

      const earthMat = new THREE.MeshStandardMaterial({
        map: earthDayTex,
        roughness: 0.65,
        metalness: 0.1,
        bumpScale: 0.04
      });

      earthMesh = new THREE.Mesh(sphereGeo, earthMat);
      // Precision placement matching master reference:
      // Earth limb begins at lower-left, peaks below the headline text,
      // and continues down across the right behind the featured panels.
      earthMesh.position.set(0.42, -4.25, 0);
      earthMesh.rotation.z = THREE.MathUtils.degToRad(-19.5); // Earth axial tilt
      earthMesh.rotation.y = THREE.MathUtils.degToRad(215);   // Showing North America into view
      scene.add(earthMesh);

      // Cloud Sphere Layer
      const cloudGeo = new THREE.SphereGeometry(earthRadius * 1.008, 64, 64);
      const cloudMat = new THREE.MeshStandardMaterial({
        map: earthCloudTex,
        transparent: true,
        opacity: 0.75,
        blending: THREE.NormalBlending,
        depthWrite: false
      });
      cloudMesh = new THREE.Mesh(cloudGeo, cloudMat);
      earthMesh.add(cloudMesh);

      // 1. Inner Atmosphere Rim Glow (on surface of Earth)
      const innerAtmoGeo = new THREE.SphereGeometry(earthRadius * 1.012, 64, 64);
      const innerAtmoMat = new THREE.ShaderMaterial({
        vertexShader: `
          varying vec3 vNormal;
          varying vec3 vViewPosition;
          void main() {
            vNormal = normalize(normalMatrix * normal);
            vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);
            vViewPosition = -mvPosition.xyz;
            gl_Position = projectionMatrix * mvPosition;
          }
        `,
        fragmentShader: `
          varying vec3 vNormal;
          varying vec3 vViewPosition;
          void main() {
            vec3 viewDir = normalize(vViewPosition);
            float dotNV = max(dot(viewDir, vNormal), 0.0);
            float fresnel = 1.0 - dotNV;
            fresnel = pow(fresnel, 3.2);
            vec3 cyanGlow = mix(vec3(0.15, 0.6, 1.0), vec3(0.65, 0.95, 1.0), fresnel);
            gl_FragColor = vec4(cyanGlow, fresnel * 0.9);
          }
        `,
        blending: THREE.AdditiveBlending,
        side: THREE.FrontSide,
        transparent: true,
        depthWrite: false
      });
      innerAtmosphereMesh = new THREE.Mesh(innerAtmoGeo, innerAtmoMat);
      earthMesh.add(innerAtmosphereMesh);

      // 2. Outer Atmospheric Rayleigh Halo (Extends softly into space)
      const outerAtmoGeo = new THREE.SphereGeometry(earthRadius * 1.045, 64, 64);
      const outerAtmoMat = new THREE.ShaderMaterial({
        vertexShader: `
          varying vec3 vNormal;
          void main() {
            vNormal = normalize(normalMatrix * normal);
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
          }
        `,
        fragmentShader: `
          varying vec3 vNormal;
          void main() {
            float intensity = pow(0.68 - dot(vNormal, vec3(0, 0, 1.0)), 2.6);
            vec3 atmosphereColor = mix(vec3(0.08, 0.48, 1.0), vec3(0.55, 0.92, 1.0), intensity);
            gl_FragColor = vec4(atmosphereColor, intensity * 0.85);
          }
        `,
        blending: THREE.AdditiveBlending,
        side: THREE.BackSide,
        transparent: true,
        depthWrite: false
      });
      outerAtmosphereMesh = new THREE.Mesh(outerAtmoGeo, outerAtmoMat);
      earthMesh.add(outerAtmosphereMesh);

      attemptHighResTextureUpgrade(earthMat, cloudMat);
    }

    function attemptHighResTextureUpgrade(earthMat, cloudMat) {
      const loader = new THREE.TextureLoader();
      loader.setCrossOrigin('anonymous');
      
      const dayUrl = 'https://unpkg.com/three-globe/example/img/earth-blue-marble.jpg';
      const cloudsUrl = 'https://unpkg.com/three-globe/example/img/earth-clouds.png';

      loader.load(dayUrl, function(tex) {
        tex.wrapS = THREE.RepeatWrapping;
        earthMat.map = tex;
        earthMat.needsUpdate = true;
      }, undefined, function() {});

      loader.load(cloudsUrl, function(tex) {
        tex.wrapS = THREE.RepeatWrapping;
        cloudMat.map = tex;
        cloudMat.needsUpdate = true;
      }, undefined, function() {});
    }

    /* --------------------------------------------------------------------------
       Orbital Satellite & Trajectory Line (Matches master screenshot!)
       -------------------------------------------------------------------------- */
    function createSatelliteOrbit() {
      // 3D curved trajectory cutting across upper atmosphere
      const curve = new THREE.CatmullRomCurve3([
        new THREE.Vector3(-3.4, -1.4, 1.0),
        new THREE.Vector3(-1.8, -0.6, 1.4),
        new THREE.Vector3(-0.35, 0.08, 1.3),
        new THREE.Vector3(1.2, 0.05, 1.0),
        new THREE.Vector3(3.2, -0.35, 0.5)
      ]);

      const points = curve.getPoints(90);
      const orbitGeo = new THREE.BufferGeometry().setFromPoints(points);

      const orbitMat = new THREE.LineDashedMaterial({
        color: 0x9be8ff,
        linewidth: 1,
        scale: 1,
        dashSize: 0.1,
        gapSize: 0.05,
        transparent: true,
        opacity: 0.6
      });

      orbitLine = new THREE.Line(orbitGeo, orbitMat);
      orbitLine.computeLineDistances();
      scene.add(orbitLine);

      // Build satellite model (ISS style)
      function buildSatelliteMesh(scale = 1.0) {
        const group = new THREE.Group();

        // Main body
        const bodyGeo = new THREE.BoxGeometry(0.04, 0.04, 0.08);
        const bodyMat = new THREE.MeshStandardMaterial({ color: 0xedf4ff, metalness: 0.9, roughness: 0.15 });
        const body = new THREE.Mesh(bodyGeo, bodyMat);
        group.add(body);

        // Solar panels
        const panelGeo = new THREE.BoxGeometry(0.18, 0.005, 0.05);
        const panelMat = new THREE.MeshStandardMaterial({ color: 0x184878, metalness: 0.8, roughness: 0.25 });
        
        const leftPanel = new THREE.Mesh(panelGeo, panelMat);
        leftPanel.position.set(-0.11, 0, 0);
        group.add(leftPanel);

        const rightPanel = new THREE.Mesh(panelGeo, panelMat);
        rightPanel.position.set(0.11, 0, 0);
        group.add(rightPanel);

        // Communications Dish
        const dishGeo = new THREE.ConeGeometry(0.02, 0.015, 8, 1, true);
        const dishMat = new THREE.MeshStandardMaterial({ color: 0xffd166, metalness: 0.7, roughness: 0.3 });
        const dish = new THREE.Mesh(dishGeo, dishMat);
        dish.position.set(0, 0.028, 0);
        dish.rotation.x = Math.PI;
        group.add(dish);

        // Beacon LED
        const beaconGeo = new THREE.SphereGeometry(0.01, 6, 6);
        const beaconMat = new THREE.MeshBasicMaterial({ color: 0x00e699 });
        const beacon = new THREE.Mesh(beaconGeo, beaconMat);
        beacon.position.set(0, -0.025, 0.035);
        group.add(beacon);

        group.scale.set(scale, scale, scale);
        return group;
      }

      // Satellite 1: Primary satellite prominent at center-limb
      satelliteMesh1 = buildSatelliteMesh(1.15);
      satelliteMesh1.curve = curve;
      satelliteMesh1.progress = 0.52; // Matches master screenshot position!
      scene.add(satelliteMesh1);

      // Satellite 2: Trailing secondary satellite near lower-left
      satelliteMesh2 = buildSatelliteMesh(0.85);
      satelliteMesh2.curve = curve;
      satelliteMesh2.progress = 0.18; // Matches master screenshot position!
      scene.add(satelliteMesh2);
    }

    /* --------------------------------------------------------------------------
       Independent Animation Loop (Continues smoothly during page scroll)
       -------------------------------------------------------------------------- */
    function animate() {
      requestAnimationFrame(animate);

      const delta = clock.getDelta();

      // Earth rotates continuously around its axis
      // Scrolling DOES NOT control or reset this rotation
      if (earthMesh) {
        earthMesh.rotation.y += 0.03 * delta;
      }

      // Clouds rotate with subtle differential velocity
      if (cloudMesh) {
        cloudMesh.rotation.y += 0.036 * delta;
      }

      // Satellites glide along orbital trajectory
      [satelliteMesh1, satelliteMesh2].forEach((sat) => {
        if (sat && sat.curve) {
          sat.progress += 0.011 * delta;
          if (sat.progress > 1.0) sat.progress = 0.0;

          const pos = sat.curve.getPoint(sat.progress);
          const tangent = sat.curve.getTangent(sat.progress);

          sat.position.copy(pos);
          sat.quaternion.setFromUnitVectors(new THREE.Vector3(0, 0, 1), tangent);
        }
      });

      renderer.render(scene, camera);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initThree);
    } else {
      initThree();
    }


    /* ==========================================================================
       2. PROCEDURAL HIGH-QUALITY SCIENTIFIC ARTWORK GENERATOR
       Renders crisp, realistic canvas graphics for all cards & news panels
       ========================================================================== */
    function drawArt(canvasId, drawerFn) {
      const c = document.getElementById(canvasId);
      if (!c) return;
      const ctx = c.getContext('2d');
      const w = c.width;
      const h = c.height;
      drawerFn(ctx, w, h);
    }

    function initArtworkCanvases() {
      // News 1: Blue Earth Horizon
      drawArt('news-canvas-1', (ctx, w, h) => {
        ctx.fillStyle = '#050c18';
        ctx.fillRect(0, 0, w, h);
        const grad = ctx.createRadialGradient(w*0.5, h*1.4, 10, w*0.5, h*1.4, w*0.8);
        grad.addColorStop(0, '#3888cc');
        grad.addColorStop(0.6, '#0f3a68');
        grad.addColorStop(1, '#050c18');
        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.arc(w*0.5, h*1.4, w*0.75, 0, Math.PI*2);
        ctx.fill();
        ctx.strokeStyle = '#7be0ff';
        ctx.lineWidth = 2.5;
        ctx.stroke();
      });

      // News 1 Badge: Spiral Galaxy
      drawArt('news-badge-1', (ctx, w, h) => {
        ctx.fillStyle = '#03060f';
        ctx.fillRect(0, 0, w, h);
        ctx.fillStyle = '#9bd0ff';
        for(let i=0; i<30; i++) {
          const a = i * 0.3;
          const r = i * 0.8;
          ctx.fillRect(w/2 + Math.cos(a)*r, h/2 + Math.sin(a)*r*0.5, 1.5, 1.5);
          ctx.fillRect(w/2 - Math.cos(a)*r, h/2 - Math.sin(a)*r*0.5, 1.5, 1.5);
        }
      });

      // News 2: Fiery Solar/Nebula event
      drawArt('news-canvas-2', (ctx, w, h) => {
        const grad = ctx.createLinearGradient(0, 0, w, h);
        grad.addColorStop(0, '#5a1e05');
        grad.addColorStop(0.5, '#ad4b0d');
        grad.addColorStop(1, '#070b14');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, w, h);
        ctx.fillStyle = '#ffaa33';
        ctx.beginPath();
        ctx.arc(w*0.3, h*0.5, 16, 0, Math.PI*2);
        ctx.fill();
      });

      // News 2 Badge: Comet with streak
      drawArt('news-badge-2', (ctx, w, h) => {
        ctx.fillStyle = '#040912';
        ctx.fillRect(0, 0, w, h);
        const streak = ctx.createLinearGradient(0, h, w, 0);
        streak.addColorStop(0, 'rgba(0, 230, 153, 0.8)');
        streak.addColorStop(1, 'transparent');
        ctx.strokeStyle = streak;
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(8, h - 8);
        ctx.lineTo(w - 6, 6);
        ctx.stroke();
      });

      // News 3: Planetary alignment
      drawArt('news-canvas-3', (ctx, w, h) => {
        ctx.fillStyle = '#040812';
        ctx.fillRect(0, 0, w, h);
        const planets = [
          { x: 18, y: h/2, r: 8, col: '#ffaa33' },
          { x: 42, y: h/2, r: 5, col: '#64d2ff' },
          { x: 68, y: h/2, r: 6, col: '#d98236' }
        ];
        planets.forEach(p => {
          ctx.fillStyle = p.col;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI*2);
          ctx.fill();
        });
      });

      // News 3 Badge: Galaxy
      drawArt('news-badge-3', (ctx, w, h) => {
        ctx.fillStyle = '#02050c';
        ctx.fillRect(0, 0, w, h);
        ctx.fillStyle = '#c7b3ff';
        ctx.beginPath();
        ctx.ellipse(w/2, h/2, 12, 6, 0.4, 0, Math.PI*2);
        ctx.fill();
      });

      // --- FEATURE CARDS SET 1 (Master Reference Exact Match!) ---

      // Card 1: EXOPLANETS (Distant gas giant world + twin glowing stars)
      drawArt('art-exoplanets', (ctx, w, h) => {
        ctx.fillStyle = '#02050e';
        ctx.fillRect(0, 0, w, h);
        
        // Stars in space
        for (let i = 0; i < 40; i++) {
          ctx.fillStyle = `rgba(255,255,255,${Math.random() * 0.75})`;
          ctx.fillRect(Math.random() * w, Math.random() * h, 1.2, 1.2);
        }

        // Primary Twin Star (Warm White Corona)
        const starGrad = ctx.createRadialGradient(w * 0.84, h * 0.36, 1, w * 0.84, h * 0.36, 26);
        starGrad.addColorStop(0, '#ffffff');
        starGrad.addColorStop(0.25, '#ffe566');
        starGrad.addColorStop(0.6, 'rgba(255, 140, 30, 0.45)');
        starGrad.addColorStop(1, 'transparent');
        ctx.fillStyle = starGrad;
        ctx.beginPath();
        ctx.arc(w * 0.84, h * 0.36, 26, 0, Math.PI*2);
        ctx.fill();

        // Secondary Companion Star
        ctx.fillStyle = '#ffeaa0';
        ctx.beginPath();
        ctx.arc(w * 0.7, h * 0.5, 3.2, 0, Math.PI*2);
        ctx.fill();

        // Exoplanet Sphere (Deep blue-teal gas giant with atmospheric crescent)
        const pGrad = ctx.createRadialGradient(w * 0.42, h * 0.54, 3, w * 0.36, h * 0.62, 42);
        pGrad.addColorStop(0, '#4aa4d8');
        pGrad.addColorStop(0.3, '#1c4768');
        pGrad.addColorStop(0.8, '#081422');
        pGrad.addColorStop(1, '#030810');
        ctx.fillStyle = pGrad;
        ctx.beginPath();
        ctx.arc(w * 0.38, h * 0.58, 38, 0, Math.PI*2);
        ctx.fill();

        // Glowing Cyan Atmospheric Limb
        ctx.strokeStyle = '#8ee4ff';
        ctx.lineWidth = 2.8;
        ctx.beginPath();
        ctx.arc(w * 0.38, h * 0.58, 38, -Math.PI*0.35, Math.PI*0.38);
        ctx.stroke();
      });

      // Card 2: SOLAR ACTIVITY (Blazing turbulent Sun flare prominence)
      drawArt('art-solar-activity', (ctx, w, h) => {
        ctx.fillStyle = '#0a0301';
        ctx.fillRect(0, 0, w, h);

        // Core Sun Fire
        const sunGrad = ctx.createRadialGradient(w * 0.82, h * 0.5, 5, w * 0.82, h * 0.5, 80);
        sunGrad.addColorStop(0, '#ffffff');
        sunGrad.addColorStop(0.18, '#ffea55');
        sunGrad.addColorStop(0.48, '#ff5500');
        sunGrad.addColorStop(0.85, '#771100');
        sunGrad.addColorStop(1, 'transparent');
        ctx.fillStyle = sunGrad;
        ctx.fillRect(0, 0, w, h);

        // Massive Coronal Prominence Loop
        ctx.strokeStyle = '#ffdd44';
        ctx.lineWidth = 4.2;
        ctx.shadowColor = '#ff6600';
        ctx.shadowBlur = 20;
        ctx.beginPath();
        ctx.moveTo(w * 0.68, h * 0.14);
        ctx.bezierCurveTo(w * 0.12, h * 0.22, w * 0.2, h * 0.8, w * 0.72, h * 0.9);
        ctx.stroke();
        ctx.shadowBlur = 0;

        // Coronal plasma filaments
        ctx.strokeStyle = 'rgba(255, 200, 80, 0.7)';
        ctx.lineWidth = 2.0;
        ctx.beginPath();
        ctx.moveTo(w * 0.75, h * 0.28);
        ctx.quadraticCurveTo(w * 0.32, h * 0.44, w * 0.78, h * 0.72);
        ctx.stroke();
      });

      // Card 3: SPACE MISSIONS (Mars Rover on red Martian landscape)
      drawArt('art-space-missions', (ctx, w, h) => {
        // Dusky Martian Sky Gradient
        const skyGrad = ctx.createLinearGradient(0, 0, 0, h);
        skyGrad.addColorStop(0, '#4e2318');
        skyGrad.addColorStop(0.55, '#853e26');
        skyGrad.addColorStop(1, '#b05434');
        ctx.fillStyle = skyGrad;
        ctx.fillRect(0, 0, w, h);

        // Red Terrain Dunes & Rocks
        ctx.fillStyle = '#6b2e1a';
        ctx.beginPath();
        ctx.moveTo(0, h * 0.65);
        ctx.quadraticCurveTo(w * 0.42, h * 0.55, w, h * 0.68);
        ctx.lineTo(w, h);
        ctx.lineTo(0, h);
        ctx.fill();

        // Foreground Terrain
        ctx.fillStyle = '#542212';
        ctx.beginPath();
        ctx.moveTo(0, h * 0.76);
        ctx.quadraticCurveTo(w * 0.6, h * 0.7, w, h * 0.84);
        ctx.lineTo(w, h);
        ctx.lineTo(0, h);
        ctx.fill();

        // Rover Silhouette (Perseverance style with mast and wheels)
        ctx.fillStyle = '#1c100a';
        ctx.fillRect(w * 0.42, h * 0.58, 40, 17); // Body
        ctx.fillRect(w * 0.65, h * 0.38, 3.5, 23); // Mast
        ctx.fillRect(w * 0.6, h * 0.36, 12, 7);  // SuperCam head
        ctx.fillRect(w * 0.33, h * 0.54, 11, 4.5); // Robotic Arm

        // Rocker-Bogie 6 Wheels
        ctx.beginPath();
        ctx.arc(w * 0.44, h * 0.82, 6.5, 0, Math.PI*2);
        ctx.arc(w * 0.61, h * 0.82, 6.5, 0, Math.PI*2);
        ctx.arc(w * 0.78, h * 0.82, 6.5, 0, Math.PI*2);
        ctx.fill();
      });

      // Card 4: CONSTELLATIONS (Star charts with blue celestial grid lines)
      drawArt('art-constellations', (ctx, w, h) => {
        ctx.fillStyle = '#030915';
        ctx.fillRect(0, 0, w, h);

        // Faint Coordinate Rings & Axes
        ctx.strokeStyle = 'rgba(70, 140, 220, 0.22)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.arc(w * 0.5, h * 0.5, 56, 0, Math.PI * 2);
        ctx.arc(w * 0.5, h * 0.5, 30, 0, Math.PI * 2);
        ctx.moveTo(0, h * 0.5); ctx.lineTo(w, h * 0.5);
        ctx.moveTo(w * 0.5, 0); ctx.lineTo(w * 0.5, h);
        ctx.stroke();

        // Constellation Stars
        const stars = [
          [28, 30], [52, 44], [86, 42], [112, 28],
          [120, 58], [94, 70], [64, 66]
        ];

        // Connecting Star Lines
        ctx.strokeStyle = 'rgba(120, 210, 255, 0.82)';
        ctx.lineWidth = 1.6;
        ctx.beginPath();
        stars.forEach((s, idx) => {
          if (idx === 0) ctx.moveTo(s[0], s[1]);
          else ctx.lineTo(s[0], s[1]);
        });
        ctx.stroke();

        // Glowing Star Nodes
        ctx.fillStyle = '#ffffff';
        stars.forEach(s => {
          ctx.beginPath();
          ctx.arc(s[0], s[1], 3.0, 0, Math.PI*2);
          ctx.fill();
        });
      });

      // Card 5: DEEP SPACE (Pillars of Creation / Golden Teal Nebula)
      drawArt('art-deep-space', (ctx, w, h) => {
        ctx.fillStyle = '#02050b';
        ctx.fillRect(0, 0, w, h);

        // Teal & Gold Gas Clouds
        const nebGrad = ctx.createRadialGradient(w * 0.46, h * 0.6, 6, w * 0.46, h * 0.6, 75);
        nebGrad.addColorStop(0, '#4fb5aa');
        nebGrad.addColorStop(0.38, '#b27a32');
        nebGrad.addColorStop(0.72, '#282b54');
        nebGrad.addColorStop(1, 'transparent');
        ctx.fillStyle = nebGrad;
        ctx.fillRect(0, 0, w, h);

        // Towering Dust Columns (Pillars)
        ctx.fillStyle = '#0d0907';
        ctx.beginPath();
        ctx.moveTo(w * 0.32, h);
        ctx.lineTo(w * 0.36, h * 0.32);
        ctx.quadraticCurveTo(w * 0.44, h * 0.28, w * 0.48, h * 0.48);
        ctx.lineTo(w * 0.58, h * 0.24);
        ctx.quadraticCurveTo(w * 0.66, h * 0.22, w * 0.68, h * 0.58);
        ctx.lineTo(w * 0.82, h);
        ctx.fill();
      });

      // Card 6: COSMIC TIMELINE (Gradient spectrum bar from Big Bang)
      drawArt('art-cosmic-timeline', (ctx, w, h) => {
        ctx.fillStyle = '#04060c';
        ctx.fillRect(0, 0, w, h);

        // Timeline Spectrum Bar
        const barGrad = ctx.createLinearGradient(12, 0, w - 12, 0);
        barGrad.addColorStop(0, '#ff4400');    // Big Bang
        barGrad.addColorStop(0.25, '#ffaa00');  // Inflation & Recombination
        barGrad.addColorStop(0.5, '#00d4ff');   // Cosmic Dawn & First Stars
        barGrad.addColorStop(0.75, '#4060ff');  // Galaxy Evolution
        barGrad.addColorStop(1, '#9900ff');     // Dark Energy Era

        ctx.fillStyle = barGrad;
        ctx.fillRect(12, h * 0.58, w - 24, 11);

        // Epoch Milestones
        [24, w * 0.38, w * 0.68, w - 24].forEach((x) => {
          ctx.fillStyle = '#ffffff';
          ctx.beginPath();
          ctx.arc(x, h * 0.63, 4.5, 0, Math.PI*2);
          ctx.fill();
          ctx.strokeStyle = 'rgba(255,255,255,0.45)';
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(x, h * 0.34);
          ctx.lineTo(x, h * 0.55);
          ctx.stroke();
        });
      });

      // --- FEATURE CARDS SET 0 (Solar System, Predictions, Asteroids, etc.) ---

      drawArt('art-solar-system', (ctx, w, h) => {
        ctx.fillStyle = '#040a15';
        ctx.fillRect(0, 0, w, h);
        ctx.fillStyle = '#ffaa22';
        ctx.beginPath(); ctx.arc(10, h/2, 28, 0, Math.PI*2); ctx.fill();
        ctx.strokeStyle = 'rgba(255,255,255,0.15)';
        ctx.lineWidth = 1;
        [50, 75, 105, 135].forEach((rad, i) => {
          ctx.beginPath(); ctx.arc(10, h/2, rad, 0, Math.PI*2); ctx.stroke();
          ctx.fillStyle = ['#99ddff', '#ff6633', '#eedd88', '#55aacc'][i];
          ctx.beginPath(); ctx.arc(10 + Math.cos(i*1.2)*rad, h/2 + Math.sin(i*1.2)*rad, 3.5, 0, Math.PI*2); ctx.fill();
        });
      });

      drawArt('art-predictions', (ctx, w, h) => {
        ctx.fillStyle = '#020713';
        ctx.fillRect(0, 0, w, h);
        ctx.strokeStyle = '#ffd166';
        ctx.lineWidth = 2;
        for (let i = 0; i < 6; i++) {
          const a = i * Math.PI / 3;
          const px = w/2 + Math.cos(a) * 22;
          const py = h/2 + Math.sin(a) * 22;
          ctx.strokeRect(px - 7, py - 7, 14, 14);
        }
      });

      drawArt('art-asteroid', (ctx, w, h) => {
        ctx.fillStyle = '#080404';
        ctx.fillRect(0, 0, w, h);
        const flame = ctx.createLinearGradient(w, 0, w*0.2, h*0.8);
        flame.addColorStop(0, '#ff3300');
        flame.addColorStop(0.6, '#ffaa00');
        flame.addColorStop(1, 'transparent');
        ctx.strokeStyle = flame;
        ctx.lineWidth = 6;
        ctx.beginPath(); ctx.moveTo(w, 10); ctx.lineTo(w*0.3, h*0.75); ctx.stroke();
        ctx.fillStyle = '#665544';
        ctx.beginPath(); ctx.arc(w*0.3, h*0.75, 12, 0, Math.PI*2); ctx.fill();
      });

      drawArt('art-galaxies', (ctx, w, h) => {
        ctx.fillStyle = '#02050f';
        ctx.fillRect(0, 0, w, h);
        const gGrad = ctx.createRadialGradient(w/2, h/2, 2, w/2, h/2, 48);
        gGrad.addColorStop(0, '#ffffff');
        gGrad.addColorStop(0.3, '#75b5ff');
        gGrad.addColorStop(0.8, '#2a3a60');
        gGrad.addColorStop(1, 'transparent');
        ctx.fillStyle = gGrad;
        ctx.beginPath(); ctx.ellipse(w/2, h/2, 48, 22, -0.4, 0, Math.PI*2); ctx.fill();
      });

      drawArt('art-explorer', (ctx, w, h) => {
        ctx.fillStyle = '#020713';
        ctx.fillRect(0, 0, w, h);
        ctx.strokeStyle = '#64d2ff';
        ctx.lineWidth = 2;
        ctx.strokeRect(w*0.25, h*0.25, w*0.5, h*0.5);
        ctx.fillStyle = '#00e699';
        ctx.beginPath(); ctx.arc(w*0.5, h*0.5, 4, 0, Math.PI*2); ctx.fill();
      });

      drawArt('art-more', (ctx, w, h) => {
        ctx.fillStyle = '#03060f';
        ctx.fillRect(0, 0, w, h);
        for(let i=0; i<45; i++) {
          ctx.fillStyle = `rgba(255,255,255,${Math.random()})`;
          ctx.fillRect(Math.random()*w, Math.random()*h, 2, 2);
        }
      });

      // --- FEATURE CARDS SET 2 (Black holes, Nebulae, Supernovae, etc.) ---

      drawArt('art-black-holes', (ctx, w, h) => {
        ctx.fillStyle = '#000000';
        ctx.fillRect(0, 0, w, h);
        ctx.strokeStyle = '#ff9900';
        ctx.lineWidth = 6;
        ctx.shadowColor = '#ff6600';
        ctx.shadowBlur = 18;
        ctx.beginPath(); ctx.ellipse(w/2, h/2, 48, 14, 0.2, 0, Math.PI*2); ctx.stroke();
        ctx.shadowBlur = 0;
        ctx.fillStyle = '#000000';
        ctx.beginPath(); ctx.arc(w/2, h/2, 18, 0, Math.PI*2); ctx.fill();
      });

      drawArt('art-nebulae', (ctx, w, h) => {
        ctx.fillStyle = '#04030a';
        ctx.fillRect(0, 0, w, h);
        const grad = ctx.createRadialGradient(w/2, h/2, 5, w/2, h/2, 42);
        grad.addColorStop(0, '#ff3388');
        grad.addColorStop(0.5, '#6622cc');
        grad.addColorStop(1, 'transparent');
        ctx.fillStyle = grad;
        ctx.beginPath(); ctx.arc(w/2, h/2, 40, 0, Math.PI*2); ctx.fill();
      });

      drawArt('art-supernovae', (ctx, w, h) => {
        ctx.fillStyle = '#050308';
        ctx.fillRect(0, 0, w, h);
        ctx.strokeStyle = '#00f0ff';
        ctx.lineWidth = 3;
        ctx.beginPath(); ctx.arc(w/2, h/2, 24, 0, Math.PI*2); ctx.stroke();
        ctx.fillStyle = '#ffffff';
        ctx.beginPath(); ctx.arc(w/2, h/2, 5, 0, Math.PI*2); ctx.fill();
      });

      drawArt('art-star-clusters', (ctx, w, h) => {
        ctx.fillStyle = '#030510';
        ctx.fillRect(0, 0, w, h);
        for(let i=0; i<70; i++) {
          const r = Math.random()*28;
          const a = Math.random()*Math.PI*2;
          ctx.fillStyle = '#ffeedd';
          ctx.fillRect(w/2 + Math.cos(a)*r, h/2 + Math.sin(a)*r, 1.5, 1.5);
        }
      });

      drawArt('art-spacecraft', (ctx, w, h) => {
        ctx.fillStyle = '#02050c';
        ctx.fillRect(0, 0, w, h);
        ctx.fillStyle = '#ddeeff';
        ctx.beginPath(); ctx.arc(w*0.5, h*0.5, 18, Math.PI*0.8, Math.PI*2.2); ctx.fill();
        ctx.strokeStyle = '#ffaa00'; ctx.lineWidth = 2;
        ctx.beginPath(); ctx.moveTo(w*0.5, h*0.5); ctx.lineTo(w*0.8, h*0.2); ctx.stroke();
      });

      drawArt('art-future-discovery', (ctx, w, h) => {
        ctx.fillStyle = '#030814';
        ctx.fillRect(0, 0, w, h);
        ctx.strokeStyle = 'rgba(100, 210, 255, 0.4)';
        ctx.lineWidth = 1.5;
        for(let r=10; r<=45; r+=10) {
          ctx.beginPath(); ctx.arc(w*0.5, h*0.5, r, 0, Math.PI*2); ctx.stroke();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initArtworkCanvases);
    } else {
      initArtworkCanvases();
    }


    /* ==========================================================================
       3. SCROLL-CONTROLLED CARD CONTENT (FIXED VIEWPORT CAROUSEL)
       Directional upward/downward transitions, scroll wheel debouncing,
       scrollbar drag interaction, and category indicator sync.
       ========================================================================== */
    let currentSetIndex = 1; // Default to Set 1 (matches master screenshot!)
    const totalSets = 3;
    let isTransitioning = false;

    const setDots = document.querySelectorAll('.set-dot');
    const scrollbarThumb = document.getElementById('scrollbar-thumb');
    const panelTitle = document.getElementById('feature-panel-title');

    const setTitles = [
      "SOLAR SYSTEM & EXPLORATION",
      "FEATURED EVENTS",
      "DEEP COSMOS & HORIZONS"
    ];

    function showCardSet(newIndex, direction = 'down') {
      if (newIndex === currentSetIndex && document.getElementById(`card-set-${newIndex}`).classList.contains('active')) {
        return;
      }
      if (isTransitioning) return;
      isTransitioning = true;

      const oldSet = document.getElementById(`card-set-${currentSetIndex}`);
      const newSet = document.getElementById(`card-set-${newIndex}`);

      // Apply directional exit class
      oldSet.classList.remove('active');
      if (direction === 'down') {
        oldSet.classList.add('exit-up');
        newSet.classList.remove('exit-up');
        newSet.classList.add('exit-down');
      } else {
        oldSet.classList.add('exit-down');
        newSet.classList.remove('exit-down');
        newSet.classList.add('exit-up');
      }

      // Force reflow
      void newSet.offsetWidth;

      // Animate new set in
      newSet.classList.remove('exit-up', 'exit-down');
      newSet.classList.add('active');

      // Update indicator dots
      setDots.forEach((dot, idx) => {
        dot.classList.toggle('active', idx === newIndex);
      });

      // Update Scrollbar Thumb Position
      if (scrollbarThumb) {
        scrollbarThumb.style.top = `${(newIndex / totalSets) * 100}%`;
      }

      // Update panel title with subtle crossfade
      if (panelTitle) {
        panelTitle.style.opacity = '0';
        setTimeout(() => {
          panelTitle.textContent = setTitles[newIndex];
          panelTitle.style.opacity = '1';
        }, 200);
      }

      currentSetIndex = newIndex;

      setTimeout(() => {
        oldSet.classList.remove('exit-up', 'exit-down');
        isTransitioning = false;
      }, 500);
    }

    // Scroll Wheel Event Listener
    let wheelTimeout;
    function handleWheelScroll(e) {
      const delta = e.deltaY;
      if (Math.abs(delta) < 25) return;

      if (wheelTimeout) return;
      wheelTimeout = setTimeout(() => { wheelTimeout = null; }, 400);

      if (delta > 0) {
        if (currentSetIndex < totalSets - 1) {
          showCardSet(currentSetIndex + 1, 'down');
        } else {
          showCardSet(0, 'down');
        }
      } else {
        if (currentSetIndex > 0) {
          showCardSet(currentSetIndex - 1, 'up');
        } else {
          showCardSet(totalSets - 1, 'up');
        }
      }
    }

    const featureViewport = document.getElementById('feature-viewport');
    if (featureViewport) {
      featureViewport.addEventListener('wheel', handleWheelScroll, { passive: true });
    }

    // Also support global page scrolling to drive the dashboard card sets!
    window.addEventListener('wheel', (e) => {
      if (!e.target.closest('#mission-modal')) {
        handleWheelScroll(e);
      }
    }, { passive: true });

    // Touch Swipe Gesture Support for mobile & tablets
    let touchStartY = 0;
    window.addEventListener('touchstart', (e) => {
      touchStartY = e.touches[0].clientY;
    }, { passive: true });

    window.addEventListener('touchend', (e) => {
      const touchEndY = e.changedTouches[0].clientY;
      const diffY = touchStartY - touchEndY;
      if (Math.abs(diffY) > 40) {
        if (diffY > 0) {
          showCardSet((currentSetIndex + 1) % totalSets, 'down');
        } else {
          showCardSet((currentSetIndex - 1 + totalSets) % totalSets, 'up');
        }
      }
    }, { passive: true });

    // Click indicators directly
    setDots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        const targetIndex = parseInt(e.currentTarget.getAttribute('data-set'), 10);
        const dir = targetIndex > currentSetIndex ? 'down' : 'up';
        showCardSet(targetIndex, dir);
      });
    });

    // Click on Scrollbar Track to jump
    const scrollbarTrack = document.getElementById('scrollbar-track');
    if (scrollbarTrack) {
      scrollbarTrack.addEventListener('click', (e) => {
        const rect = scrollbarTrack.getBoundingClientRect();
        const clickRatio = (e.clientY - rect.top) / rect.height;
        let targetIndex = Math.floor(clickRatio * totalSets);
        targetIndex = Math.max(0, Math.min(totalSets - 1, targetIndex));
        const dir = targetIndex > currentSetIndex ? 'down' : 'up';
        showCardSet(targetIndex, dir);
      });
    }

    // Keyboard Arrow Keys (Up/Down) navigation
    window.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'PageDown') {
        const next = (currentSetIndex + 1) % totalSets;
        showCardSet(next, 'down');
      } else if (e.key === 'ArrowUp' || e.key === 'PageUp') {
        const prev = (currentSetIndex - 1 + totalSets) % totalSets;
        showCardSet(prev, 'up');
      }
    });


    /* ==========================================================================
       4. CARD POINTER INTERACTION (SUBTLE 3D TILT & SPECULAR SHEEN)
       ========================================================================== */
    const cards = document.querySelectorAll('.feature-card');
    cards.forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
      });

      card.addEventListener('click', (e) => {
        const slug = card.getAttribute('data-slug');
        if (slug === 'asteroid-collision') {
          e.preventDefault();
          e.stopPropagation();
          const m = document.getElementById('mission-modal');
          if (m) {
            m.classList.remove('open');
            m.setAttribute('aria-hidden', 'true');
            m.style.display = 'none';
          }
          if (window.astraCollisionApp) {
            window.astraCollisionApp.launch();
          }
          return;
        }
        const title = card.querySelector('.card-title')?.textContent || 'MISSION';
        const desc = card.querySelector('.card-desc')?.textContent || '';
        openModal(title, desc, slug);
      });
    });


    /* ==========================================================================
       5. INTERACTIVE MISSION DOSSIER / MODAL DIALOG
       ========================================================================== */
    const modal = document.getElementById('mission-modal');
    const modalTitle = document.getElementById('modal-title');
    const modalBody = document.getElementById('modal-body');
    const modalStats = document.getElementById('modal-stats');
    const modalCloseBtn = document.getElementById('modal-close-btn');
    const modalBackBtn = document.getElementById('modal-back-btn');
    const modalActionBtn = document.getElementById('modal-action-btn');

    const cardDetails = {
      'exoplanets': {
        tag: 'DEEP SPACE EXPLORATION',
        body: "Explore worlds orbiting distant stars outside our Solar System. From scorched 'hot Jupiters' to ocean-covered super-Earths, over 5,600 exoplanets have been confirmed by space telescopes including Kepler, TESS, and James Webb.",
        stats: [
          { label: 'Confirmed Worlds', val: '5,632' },
          { label: 'Habitable Candidates', val: '168' },
          { label: 'Observation Depth', val: '28,000 ly' }
        ],
        action: 'Launch Exoplanet Explorer'
      },
      'solar-activity': {
        tag: 'HELIOPHYSICS DIVISION',
        body: "Monitor the 11-year solar cycle, coronal mass ejections (CMEs), and geomagnetic solar storms in real-time using NASA SDO and ESA Solar Orbiter telemetry.",
        stats: [
          { label: 'Current Sunspot No.', val: '142' },
          { label: 'Solar Wind Speed', val: '438 km/s' },
          { label: 'Cycle Status', val: 'Solar Max 25' }
        ],
        action: 'Analyze Solar Telemetry'
      },
      'space-missions': {
        tag: 'EXPLORATION CHRONICLES',
        body: "Follow robotic probes, Mars rovers, and crewed lunar missions. Review Artemis flight paths, Perseverance rover rock samples, and the Europa Clipper trajectory.",
        stats: [
          { label: 'Active Missions', val: '44' },
          { label: 'Furthest Probe', val: '24.2B km' },
          { label: 'Crew in Orbit', val: '10' }
        ],
        action: 'View Mission Trajectories'
      },
      'constellations': {
        tag: 'CELESTIAL CARTOGRAPHY',
        body: "Interactive star charts and cultural constellation lore. Trace ancient astronomical sky maps and align them with modern 3D Gaia stellar velocity vectors.",
        stats: [
          { label: 'Mapped Constellations', val: '88 IAU' },
          { label: 'Catalogued Stars', val: '1.8 Billion' },
          { label: 'Epoch Reference', val: 'J2000.0' }
        ],
        action: 'Open Interactive Sky Map'
      },
      'deep-space': {
        tag: 'ASTROPHYSICAL PHENOMENA',
        body: "Venture past stellar nurseries, planetary nebulae, and ancient globular clusters. High-resolution multispectral imagery captured in infrared, optical, and X-ray.",
        stats: [
          { label: 'Messier Objects', val: '110' },
          { label: 'Deepest Field', val: '13.4B yrs' },
          { label: 'Star Clusters', val: '150+' }
        ],
        action: 'Explore Deep Nebulae'
      },
      'cosmic-timeline': {
        tag: 'COSMOLOGY & EVOLUTION',
        body: "Journey from the Big Bang 13.8 billion years ago, through Cosmic Dawn and the reionization epoch, to the modern era of galaxy clusters and dark energy expansion.",
        stats: [
          { label: 'Universe Age', val: '13.787 Gyr' },
          { label: 'Hubble Constant', val: '67.4 km/s/Mpc' },
          { label: 'CMB Temp', val: '2.725 K' }
        ],
        action: 'Traverse Cosmic Eras'
      }
    };

    function openModal(title, desc, slug) {
      if (slug === 'asteroid-collision') return;
      const data = cardDetails[slug] || {
        tag: 'ASTRA RECONNAISSANCE',
        body: desc + ' Comprehensive interactive module prepared for planetary telemetry and simulation.',
        stats: [
          { label: 'Status', val: 'Online' },
          { label: 'Telemetry', val: 'Active' },
          { label: 'Latency', val: '1.2s LEO' }
        ],
        action: `Explore ${title}`
      };

      document.getElementById('modal-tag').textContent = data.tag;
      modalTitle.textContent = title;
      modalBody.textContent = data.body;
      modalActionBtn.textContent = `${data.action} →`;

      modalStats.innerHTML = data.stats.map(s => `
        <div class="stat-box">
          <span class="stat-label">${s.label}</span>
          <span class="stat-value">${s.val}</span>
        </div>
      `).join('');

      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
    }

    function closeModal() {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
    }

    modalCloseBtn?.addEventListener('click', closeModal);
    modalBackBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.querySelectorAll('.news-item, .upcoming-item').forEach(item => {
      item.addEventListener('click', () => {
        const title = item.querySelector('.news-title, .upcoming-title')?.textContent || 'ASTRONOMY UPDATE';
        openModal(title, 'Observational bulletins and telemetry provided by global astronomical observatories and satellite constellations.', 'news');
      });
    });

    // Start Exploring CTA click
    document.getElementById('start-explore-btn')?.addEventListener('click', (e) => {
      e.preventDefault();
      showCardSet(1, 'down');
      const firstCard = document.querySelector('#card-set-1 .feature-card');
      firstCard?.scrollIntoView({ behavior: 'smooth' });
      firstCard?.click();
    });


    /* ==========================================================================
       6. AMBIENT AUDIO SYNTHESIZER (WEB AUDIO API - SUBTLE ORBITAL DRONE)
       ========================================================================== */
    let audioCtx, osc, filter, gainNode;
    let isAudioPlaying = false;
    const audioBtn = document.getElementById('audio-toggle');

    function toggleAudio() {
      if (!audioCtx) {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        audioCtx = new AudioContext();

        osc = audioCtx.createOscillator();
        const osc2 = audioCtx.createOscillator();
        filter = audioCtx.createBiquadFilter();
        gainNode = audioCtx.createGain();

        osc.type = 'sine';
        osc.frequency.setValueAtTime(55, audioCtx.currentTime);

        osc2.type = 'triangle';
        osc2.frequency.setValueAtTime(110, audioCtx.currentTime);

        filter.type = 'lowpass';
        filter.frequency.setValueAtTime(160, audioCtx.currentTime);

        gainNode.gain.setValueAtTime(0.045, audioCtx.currentTime);

        osc.connect(filter);
        osc2.connect(filter);
        filter.connect(gainNode);
        gainNode.connect(audioCtx.destination);

        osc.start();
        osc2.start();
        isAudioPlaying = true;
        audioBtn.style.color = 'var(--accent-cyan)';
      } else {
        if (audioCtx.state === 'suspended') {
          audioCtx.resume();
          isAudioPlaying = true;
          audioBtn.style.color = 'var(--accent-cyan)';
        } else if (audioCtx.state === 'running') {
          audioCtx.suspend();
          isAudioPlaying = false;
          audioBtn.style.color = 'var(--text-muted)';
        }
      }
    }

    audioBtn?.addEventListener('click', toggleAudio);

    // Fullscreen Toggle
    const fsBtn = document.getElementById('fs-toggle');
    fsBtn?.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    });

  })();
  </script>

  <!-- ASTRA Asteroid Collision Physics, Data & Simulation Engines -->
  <script src="js/collision-physics.js"></script>
  <script src="js/collision-nasa-data.js"></script>
  <script src="js/collision-map.js"></script>
  <script src="js/collision-sim3d.js"></script>
  <script src="js/collision-app.js"></script>
</body>
</html>